# ArtVault Environment Configuration Example
# Copy this file to .env and populate with your credentials

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/artvault?schema=public"

# Auth Providers (NextAuth / Supabase)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-development-key-here"

# SMS OTP Gateways (India)
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Razorpay India Payment Gateway (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Shiprocket / Delhivery Courier Scheduled Pickup API
DELHIVERY_API_TOKEN=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
